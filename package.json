{
  "name": "dsh-session-pin",
  "version": "0.7.2",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "description": "Pin sessions and workspaces to the top of the DeepSeek Harness sidebar with per-pin row colors 閳?a dual-face (host + client) dsh plugin with row [pin][swatch] controls, a header toggle, and a pinned panel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-session-pin.git"
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-plugin",
      "dispose": "supported"
    },
    "permissions": [
      "browser:local-storage",
      "settings:read",
      "settings:write"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.2-alpha.5"
      ]
    },
    "capability": {
      "id": "session-pin-toggle",
      "kind": "ui",
      "invocation": "click the pushpin on a session row",
      "expected": "the session joins the pinned set and moves to the front of its workspace account"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-pin",
    "pin",
    "workspace"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.es.md",
    "README.pt.md",
    "README.hi.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "check:readmes": "node scripts/check-readme-sync.mjs",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    }
  },
  "devDependencies": {"@deepseek-ai/dsh-workspace": "0.1.2-alpha.5", "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5", 
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "22.19.0",
    "@types/react": "18.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "^0.25.0",
    "jsdom": "26.0.0",
    "oxlint": "0.18.1",
    "playwright": "^1.62.1",
    "react": "18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  }
}
